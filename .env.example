# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nova:dev_pass@localhost:5432/nova

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_64_char_string_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Storage (S3 compatible) ───────────────────────────
S3_ENDPOINT=http://localhost:9000       # MinIO en dev / Hostinger Object Storage en prod
S3_BUCKET=nova-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/nova-dev

# ── Email (SMTP) ──────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@tu-dominio.com
SMTP_PASSWORD=change_this
SMTP_FROM=Nova Fora <noreply@tu-dominio.com>

# ── Email via Gmail API (preferred over SMTP when all four are set) ──
# OAuth client from Google Cloud (consent screen = Internal), refresh token
# of the sender mailbox with scope gmail.send. Never commit real values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=                    # e.g. jescalona@dantzigfleets.com

# ── DFS repair marketplace ────────────────────────────
MARKETPLACE_FROM_EMAIL=          # sending mailbox; empty → GMAIL_SENDER / SMTP_FROM
MARKETPLACE_FROM_NAME=DFS Repair Marketplace
MARKETPLACE_REPLY_TO=            # empty → replies go to the From mailbox
MARKETPLACE_FEE_RATE=0.10
MARKETPLACE_LOOKBACK_DAYS=14
MARKETPLACE_REOFFER_AFTER_DAYS=30
MARKETPLACE_TOKEN_SECRET=        # empty → JWT_SECRET
MARKETPLACE_PROSPECT_LINK_TTL_DAYS=30
MARKETPLACE_TERMS_VERSION=2026-11-04
MARKETPLACE_TERMS_URL=
MARKETPLACE_SYSTEM_USER_EMAIL=   # inviter on prospect invitations; empty → first site_admin
ANTHROPIC_API_KEY=               # digest opener; empty → template only
MARKETPLACE_DIGEST_MODEL=claude-opus-5-5

# ── Frontend ──────────────────────────────────────────
# En nova-fora-demo/.env.local:
VITE_API_BASE_URL=http://localhost:8000

# ── Observabilidad ────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=

# ── App ───────────────────────────────────────────────
ENV=development          # development | production
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
